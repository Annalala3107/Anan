# Google Gemini API Configuration (Server-only - Optional: Users can also input a temporary key in sessionStorage)
GEMINI_API_KEY=your-gemini-api-key-here

# Upstash Redis Configuration (Required for Serverless 6-digit PIN 15-minute QR transfer)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Public App URL (Optional - Used to build QR transfer links & allowlisted CORS origin when testing from localhost)
NEXT_PUBLIC_APP_URL=https://your-deployment-domain.vercel.app
